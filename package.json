{
  "name": "backupd-js",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --filter '@backupd/sdk' build && bun run --filter 'backupd' build",
    "check-types": "tsc -b packages/sdk packages/cli",
    "test": "tsc -b packages/sdk && vitest run",
    "lint": "oxlint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.2",
    "@types/node": "^22.15.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "packageManager": "bun@1.4.4"
}
